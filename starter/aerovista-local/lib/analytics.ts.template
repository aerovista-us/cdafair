type EventValue = string | number | boolean;
type EventData = Record<string, EventValue>;
type QueuedEvent = { eventName: string; eventData?: EventData };
type UmamiTracker = { track: (eventName: string, eventData?: EventData) => void };

declare global {
  interface Window {
    umami?: UmamiTracker;
    __aerovistaLocalAnalyticsQueue?: QueuedEvent[];
  }
}

export function trackEvent(eventName: string, eventData?: EventData) {
  if (typeof window === "undefined") return;
  try {
    if (window.umami) {
      window.umami.track(eventName, eventData);
      return;
    }
    window.__aerovistaLocalAnalyticsQueue ||= [];
    window.__aerovistaLocalAnalyticsQueue.push({ eventName, eventData });
  } catch {
    // Analytics must never interrupt the utility experience.
  }
}

export function flushQueuedEvents() {
  if (typeof window === "undefined" || !window.umami) return;
  const queue = window.__aerovistaLocalAnalyticsQueue || [];
  window.__aerovistaLocalAnalyticsQueue = [];
  for (const event of queue) {
    try {
      window.umami.track(event.eventName, event.eventData);
    } catch {
      // Keep analytics isolated from product behavior.
    }
  }
}
