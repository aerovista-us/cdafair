export default function SourceNotice({ sourceName, sourceUrl, updatedLabel, children }: { sourceName: string; sourceUrl: string; updatedLabel?: string; children: React.ReactNode }) {
  return (
    <section style={{ marginTop: 16, padding: 18, border: "1px dashed rgba(255,255,255,.16)", borderRadius: 16, color: "#aeb5c1", fontSize: 13, lineHeight: 1.55 }}>
      <strong style={{ color: "#f3f4f6" }}>Source transparency</strong>
      <p style={{ margin: "7px 0 10px" }}>{children}</p>
      {updatedLabel && <p style={{ margin: "0 0 10px", fontSize: 11 }}>Last verified: {updatedLabel}</p>}
      <a href={sourceUrl} target="_blank" rel="noreferrer" style={{ color: "#f3f4f6", fontWeight: 700 }}>View {sourceName} source ↗</a>
    </section>
  );
}
